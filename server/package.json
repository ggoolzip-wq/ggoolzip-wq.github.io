{
  "name": "ggoolzip-sync",
  "version": "1.0.0",
  "description": "보스 캐릭터 관리 동기화 서버 (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "db:init:local": "wrangler d1 execute ggoolzip-sync --local --persist-to .wrangler/state --file=schema.sql",
    "db:init:remote": "wrangler d1 execute ggoolzip-sync --remote --file=schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
